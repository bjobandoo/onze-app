# -----------------------------------------------------------------------------
# .env — SOLO claves públicas de cliente.
# Este archivo se empaqueta dentro del APK/IPA (asset de flutter_dotenv), por lo
# que NUNCA debe contener secretos de servidor.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
ENVIRONMENT=development  # development | staging | production

# -----------------------------------------------------------------------------
# Credenciales de SERVIDOR (Twilio, Firebase service account, service_role key):
# NO van aquí. Se configuran como secrets en Supabase:
#   - Twilio:  Dashboard → Authentication → Providers → Phone
#   - FCM:     supabase secrets set FIREBASE_PROJECT_ID=... FIREBASE_CLIENT_EMAIL=... FIREBASE_PRIVATE_KEY=...
# Para uso local del equipo existe .env.server (gitignored, no empaquetado).
# -----------------------------------------------------------------------------
